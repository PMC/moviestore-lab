---
interface Props {
  movieid: string;
}
import { API_SECRET_TOKEN } from "astro:env/server";

const fetchData = async () => {
  try {
    const response = await fetch(`https://api.themoviedb.org/3/movie/${Astro.props.movieid}`, {
      headers: {
        Authorization: `Bearer ${API_SECRET_TOKEN}`,
      },
    });

    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

    const data = await response.json();
    return data;
  } catch (error) {
    console.error("Error fetching data:", error);
    return null;
  }
};

const movie = await fetchData();

//remove ", " at end
let companies = "";
movie.production_companies.map((c) => {
  companies += c.name + ", ";
});
companies = companies.slice(0, companies.length - 2);

/*
fetch credits
const url = 'https://api.themoviedb.org/3/movie/872585/credits?language=en-US';
*/
const fetchCredits = async () => {
  try {
    const response = await fetch(`https://api.themoviedb.org/3/movie/${Astro.props.movieid}/credits?language=en-US`, {
      headers: {
        Authorization: `Bearer ${API_SECRET_TOKEN}`,
      },
    });

    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

    const data = await response.json();
    return data;
  } catch (error) {
    console.error("Error fetching data:", error);
    return null;
  }
};
const credits = await fetchCredits();

//fetching all directors
let directors = "";

credits.cast.map((a) => {
  if (a.known_for_department === "Directing") {
    directors += a.name + ", ";
  }
});

//add crew directors

credits.crew.map((d) => {
  if (d.known_for_department === "Directing") {
    directors += d.name + ", ";
  }
});
directors = directors.slice(0, directors.length - 2);

const filteredCredits = credits.cast
  .filter((num) => num.profile_path !== null)
  .map((value) => {
    return value;
  });
---

<section>
  <article class="border-2 p-4">
    <h1>
      {movie.title}
    </h1>
    <h5>
      Rating: ({movie.vote_average}/10) - Votes: {movie.vote_count}{" "}
    </h5>
    <div class="grid">
      <img src={`https://image.tmdb.org/t/p/w300${movie.poster_path}`} />

      <ul>
        <li>
          <strong>Tagline:</strong>
          {movie.tagline}
        </li>
        <li>
          <strong>Overview:</strong>
          {movie.overview}
        </li>
        <hr />
        <li>Release date: {movie.release_date}</li>
        <li>Language: {movie.original_language.toUpperCase()}</li>
        <li>Popularity: {movie.popularity}</li>
        <li>
          Categories:
          {movie.genres.map((c) => <a href={`./../../movies?genre=${c.id}`}>#{c.name} </a>)}
        </li>
        <li><a href={movie.homepage} target="_blank">Homepage: {movie.homepage}</a></li>
        <li>
          <a href={`https://www.imdb.com/title/${movie.imdb_id}`} target="_blank"
            >Imdb: {`https://www.imdb.com/title/${movie.imdb_id}`}</a
          >
        </li>
        <li>
          Production Companies: {companies}
        </li>

        <li>
          Directors: {directors}
        </li>
      </ul>
    </div>
    <footer>
      <button class="add-to-cart" data-movieid={movie.id}> Add to cart </button>
    </footer>
  </article>
  <article>
    <h1>Credits</h1>
    <hr />
    <section class="flow-credit">
      {
        filteredCredits.map((cc) => (
          <div class="flow-items">
            <img src={`https://image.tmdb.org/t/p/w200/${cc.profile_path}`} />{" "}
            <p class="creditsText">
              {cc.name} as {cc.character} ({cc.known_for_department})
            </p>{" "}
          </div>
        ))
      }
    </section>
  </article>
</section>

<style>
  ::body {
    font-size: 16px;
  }
  .credits {
    display: flex;
  }

  div {
    grid-template-columns: minmax(300px, 320px) minmax(300px, 1fr);
    @media (width <= 680px) {
      grid-template-columns: 1fr;
    }
  }
  article {
    border-color: rgba(0, 0, 0, 0.432);
  }
  a:hover {
    color: var(--pico-primary-focus);
  }
  ul {
    margin-left: 1.5rem;
  }
  ins,
  article p,
  article ul {
    color: var(--pico-h3-color);
  }

  .flow-credit {
    display: inline-flex;
    flex-wrap: wrap;
  }
  .flow-items {
    flex-wrap: wrap;
    text-align: center;
    margin-right: 20px;
    margin-left: 20px;
    margin-top: 20px;
  }
</style>
