---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="MovieStore-lab">
  <main class="container">
    <h1>Customer Support</h1>
    <p class="intro">We're here to make your movie shopping experience smooth, enjoyable, and memorable.</p>

    <section class="contact-section">
      <hr>
      <h2>How to Reach Us</h2>
      <ul class="contact-options">
        <li>
          <strong>Email Support:</strong>
          <a href="mailto:support@moviestorelab.com">support@moviestorelab.com</a>
          <p>We aim to respond to inquiries within 24-48 hours.</p>
        </li>
        <li>
          <strong>Phone Support:</strong> (555) 123-4567
          <p>Available Monday - Friday, 9:00 AM - 6:00 PM (EST).</p>
        </li>
        <li>
          <strong>Use Contact Form</strong>
        </li>
      </ul>
    </section>

    <section class="contact-form-section">
      <hr>
      <h2>Contact Form</h2>
      <p>Prefer to reach out online? Fill out the form below, and we'll get back to you as soon as possible.</p>
      <form action="#" method="POST" class="contact-form">
        <label for="fullname-contact-form">Full Name</label>
        <input type="text" id="fullname-contact-form" name="fullname" placeholder="Your Full Name" required />

        <label for="email-contact-form">Email</label>
        <input type="email" id="email-contact-form" name="email" placeholder="Your Email Address" required />

        <label for="Topic">Topic</label>
        <select name="Topic" aria-label="Select Topic" required>
          <option selected disabled value="">Select Topic</option>
          <option>Account Assistance</option>
          <option>Billing & Payments</option>
          <option>Order Status</option>
          <option>Refunds & Exchanges</option>
          <option>Other...</option>
        </select>

        <label for="message-contact-form">Message</label>
        <textarea id="message-contact-form" name="message" rows="5" placeholder="Write your message here..." required></textarea>

        <button type="submit" class="submit-button">Send Message</button>
      </form>
    </section>

    <section class="common-topics">
      <hr>
      <h2>Common Topics</h2>
      <ul>
        <li>
          <strong>Order Status:</strong>
          <p>Check your order status in your account under “My Orders.” For delays or shipping questions, please contact us.</p>
        </li>
        <li>
          <strong>Refunds & Exchanges:</strong>
          <p>If you're unsatisfied or received a damaged disc, let us know. We'll guide you through returns and exchanges or provide a refund according to our policy.</p>
        </li>
        <li>
          <strong>Billing & Payments:</strong>
          <p>Questions about charges or payment methods? We can clarify billing details and payment options, or correct any errors.</p>
        </li>
        <li>
          <strong>Account Assistance:</strong>
          <p>Forgot your password or notice unusual activity? We can help reset your password and secure your account.</p>
        </li>
      </ul>
    </section>

    <section class="additional-resources">
      <hr>
      <h2>Additional Resources</h2>
      <ul>
        <li><strong>FAQs:</strong> <a href="#">Frequently Asked Questions</a> - Quick answers to shipping, orders, and digital downloads.</li>
        <li><strong>Help Articles:</strong> <a href="#">Browse Help Center</a> - Step-by-step guides on account settings, watchlists, and premium features.</li>
      </ul>
    </section>

    <section class="our-promise">
      <hr>
      <h2>Our Promise</h2>
      <p>
        We want you to enjoy hassle-free browsing and purchasing of your favorite films. If there's anything we can do
        to improve your experience, please let us know. Our team is committed to providing top-notch support and
        resolving your questions promptly.
      </p>
      <p>Thank you for choosing MovieDatabase, and happy viewing!</p>
    </section>
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
  }

  h1, h2 {
    margin-top: 100px;
    margin-bottom: 25px;
  }

  .intro {
    margin-bottom: 100px;
    font-size: 1.3rem;
  }

  .contact-section, 
  .contact-form-section, 
  .common-topics, 
  .additional-resources, 
  .our-promise {
    margin-bottom: 100px;
  }

  ul {
    padding-left: 20px;
  }

  form.contact-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-top: 20px;
  }
</style>
