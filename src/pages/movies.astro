---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import categories from "../content/categories.json";
import { createMoviePrice } from "../scripts/moviePrices";

const url = new URL(Astro.request.url);
const genre = url.searchParams.get("genre") || "all";
const startYear = url.searchParams.get("startYear");
const endYear = url.searchParams.get("endYear");
const ranking = url.searchParams.get("ranking");
const international = url.searchParams.get("international") || "all";
const sortBy = url.searchParams.get("sortBy") || "alphabetical";
const searchQuery = (url.searchParams.get("search") || "").toLowerCase();

let movies = await getCollection("apiMovies");
let genreHeader = "All Movies";
let genreDescription =
  "These are all the movies available in alphabetical order.";

// Apply Genre Filter
if (genre !== "all") {
  const selectedGenre = categories.genres.find((g) => g.id === parseInt(genre));
  if (selectedGenre) {
    genreHeader = selectedGenre.name;
    genreDescription = `Explore our selection of ${selectedGenre.name} movies.`;
    movies = movies.filter((m) => m.data.genre_ids.includes(parseInt(genre)));
  }
}

// Apply Year Filter
if (startYear || endYear) {
  movies = movies.filter((m) => {
    const releaseYear = parseInt(m.data.release_date.slice(0, 4));
    if (startYear && releaseYear < parseInt(startYear)) return false;
    if (endYear && releaseYear > parseInt(endYear)) return false;
    return true;
  });
}

// Apply Ranking Filter
if (ranking) {
  movies = movies.filter((m) => {
    const vote = m.data.vote_average;
    if (ranking === "high") return vote >= 8.0;
    if (ranking === "medium") return vote >= 5.0 && vote < 8.0;
    if (ranking === "low") return vote < 5.0;
    return true;
  });
}

// Apply Language Filter
if (international === "english") {
  movies = movies.filter((m) => m.data.original_language === "en");
} else if (international === "non-english") {
  movies = movies.filter((m) => m.data.original_language !== "en");
}

// Apply Search Filter
if (searchQuery.length >= 2) {
  genreHeader = "Search Results";
  genreDescription = `Results for your search: "${searchQuery}"`;
  movies = movies.filter((m) => {
    const titleMatches = m.data.title.toLowerCase().includes(searchQuery);
    const yearMatches = m.data.release_date.slice(0, 4).includes(searchQuery);
    return titleMatches || yearMatches;
  });
}

// Apply Sorting
movies.sort((a, b) => {
  switch (sortBy) {
    case "popularity":
      return b.data.popularity - a.data.popularity;
    case "ranking":
      return b.data.vote_average - a.data.vote_average;
    case "release_date":
      return (
        new Date(b.data.release_date).getTime() -
        new Date(a.data.release_date).getTime()
      );
    default:
      return a.data.title.localeCompare(b.data.title);
  }
});
---

<BaseLayout title="MovieStore-lab">
  <main class="container-fluid fade-in">
    <header id="category-header-container">
      <h1>{genreHeader}</h1>
      <p>{genreDescription}</p>
      <button id="filter-toggle-button">Filters</button>
    </header>

    <form id="filter-form" method="get" action="/movies">
      <div class="filters">
        <div class="filterInputContainer">
          <!-- Genre Filter -->
          <label for="genre-filter">Genre:</label>
          <select id="genre-filter" name="genre">
            <option value="all">All</option>
            {
              categories.genres.map((g) => (
                <option value={g.id} selected={genre === `${g.id}`}>
                  {g.name}
                </option>
              ))
            }
          </select>

          <!-- Year Filter -->
          <label for="start-year-filter">Start Year:</label>
          <input
            id="start-year-filter"
            type="number"
            name="startYear"
            min="1900"
            max={new Date().getFullYear()}
            placeholder="Start Year"
            value={url.searchParams.get("startYear") || ""}
          />

          <label for="end-year-filter">End Year:</label>
          <input
            id="end-year-filter"
            type="number"
            name="endYear"
            min="1900"
            max={new Date().getFullYear()}
            placeholder="End Year"
            value={url.searchParams.get("endYear") || ""}
          />
        </div>

        <!-- Ranking Filter -->
        <div class="radioContainer">
          <fieldset>
            <legend>Ranking:</legend>
            <label>
              <input
                type="radio"
                name="ranking"
                value="all"
                checked={!ranking || ranking === "all"}
              />
              All Ranks
            </label>
            <label>
              <input
                type="radio"
                name="ranking"
                value="high"
                checked={ranking === "high"}
              />
              &#8805; 8.0
            </label>
            <label>
              <input
                type="radio"
                name="ranking"
                value="medium"
                checked={ranking === "medium"}
              />
              5.0 - 7.9
            </label>
            <label>
              <input
                type="radio"
                name="ranking"
                value="low"
                checked={ranking === "low"}
              />
              &lt; 5.0
            </label>
          </fieldset>

          <!-- International Filter -->
          <fieldset>
            <legend>Language:</legend>
            <label>
              <input
                type="radio"
                name="international"
                value="all"
                checked={international === "all"}
              />
              All Languages
            </label>
            <label>
              <input
                type="radio"
                name="international"
                value="english"
                checked={international === "english"}
              />
              English
            </label>
            <label>
              <input
                type="radio"
                name="international"
                value="non-english"
                checked={international === "non-english"}
              />
              Non-English
            </label>
          </fieldset>

          <!-- Sorting Filter -->
          <fieldset>
            <legend>Sort By:</legend>
            <label>
              <input
                type="radio"
                name="sortBy"
                value="alphabetical"
                checked={sortBy === "alphabetical"}
              />
              Alphabetical
            </label>
            <label>
              <input
                type="radio"
                name="sortBy"
                value="popularity"
                checked={sortBy === "popularity"}
              />
              Popularity
            </label>
            <label>
              <input
                type="radio"
                name="sortBy"
                value="ranking"
                checked={sortBy === "ranking"}
              />
              Ranking
            </label>
            <label>
              <input
                type="radio"
                name="sortBy"
                value="release_date"
                checked={sortBy === "release_date"}
              />
              Release Date
            </label>
          </fieldset>
        </div>
      </div>

      <!-- Buttons Section -->
      <div class="buttonSection">
        <button type="submit">Apply Filters</button>
        <button type="reset" id="reset-button">Reset Filters</button>
      </div>
    </form>

    <section class="grid" id="movies-grid">
      {
        movies.length === 0 ? (
          <p>Sorry, No results found for "{searchQuery}"</p>
        ) : (
          movies.map((m) => (
            <article
              class="border-2 p-4"
              data-genreids={m.data.genre_ids.join(",")}
              data-title={m.data.title.toLowerCase()}
            >
              <a href={`/movie/info/${m.id}`}>
                <img
                  src={`https://image.tmdb.org/t/p/w300${m.data.poster_path}`}
                />
                <h1>
                  {m.data.title} ({m.data.release_date.slice(0, 4)})
                </h1>
                <div class="rating">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 115.53 110.12"
                    class="star-icon"
                  >
                    <polygon
                      class="starSvg"
                      points="57.77 2.5 74.84 37.1 113.03 42.65 85.4 69.59 91.92 107.62 57.77 89.66 23.61 107.62 30.13 69.59 2.5 42.65 40.69 37.1 57.77 2.5"
                    />
                  </svg>
                  <span class="star-rating">
                    {m.data.vote_average.toFixed(1)}
                  </span>
                </div>
              </a>
              <div class="buttonArea">
                <span class="unit-price">
                  Price: {createMoviePrice(m.data.vote_average)}
                </span>
                <button class="add-to-cart" data-movieid={m.data.id}>
                  Add to cart
                </button>
              </div>
            </article>
          ))
        )
      }
    </section>
  </main>
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const resetButton = document.getElementById(
      "reset-button",
    ) as HTMLButtonElement;
    const filterForm = document.getElementById(
      "filter-form",
    ) as HTMLFormElement; 
    const filterButton = document.getElementById("filter-toggle-button");

    resetButton.addEventListener("click", () => {
      filterForm.reset();
      window.location.href = "/movies";
    });

    filterForm.style.height = "0";
    filterForm.style.opacity = "0";
    filterForm.style.overflow = "hidden";
    filterForm.style.transition = "height 0.5s ease, opacity 0.5s ease";

    filterButton.addEventListener("click", () => {
      if (filterForm.style.height === "0px") {
        filterForm.style.height = "600px";
        setTimeout(() => {
          filterForm.style.opacity = "1";
        }, 500);
      } else {
        filterForm.style.opacity = "0";
        setTimeout(() => {
          filterForm.style.height = "0";
        }, 500);
      }
    });
  });
</script>
<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.5rem 0;
    justify-content: center;
  }

  .filters label {
    margin-right: 0.5rem;
  }

  .filters input,
  .filters select,
  .filters button {
    padding: 0.5rem;
    font-size: 1rem;
  }

  #filter-form {
    margin-bottom: 2rem;
  }

  fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }

  select,
  #start-year-filter,
  #end-year-filter {
    width: 140px;
  }

  section {
    grid-template-columns: repeat(auto-fill, 30ch);
  }
  article {
    border-color: rgba(0, 0, 0, 0.432);
  }
  a:hover {
    color: var(--pico-primary-focus);
  }
  ul {
    margin-left: 1.5rem;
  }
  article p,
  article ul {
    color: var(--pico-h3-color);
  }

  h1 {
    font-size: 1rem;
    height: 2rem;
  }
  h2 {
    font-size: 0.75rem;
  }

  main {
    padding-top: 2rem;
  }
  .buttonArea {
    position: relative;
    top: -10px;
    height: 46px;
  }
  #category-header-container {
    margin-top: 40px;
    justify-items: center;
  }
  #category-header-container h1 {
    font-size: 3rem;
    color: var(--pico-h1-color);
  }
  #category-header-container p {
    font-size: 1.5rem;
    margin-bottom: 50px;
    color: var(--pico-h6-color);
    padding-top: 20px;
  }

  .rating {
    position: relative;
    top: -6rem;
    left: 12.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .star-icon {
    width: 60px;
    height: 60px;
    fill: rgba(255, 217, 0, 0.932);
    position: absolute;
  }

  .star-rating {
    position: absolute;
    font-size: 17px;
    font-weight: bold;
    color: black;
    text-align: center;
    pointer-events: none;
  }
  .grid {
    justify-content: center;
  }
  .unit-price {
    margin-right: 1.2rem;
  }

  .radioContainer {
    display: flex;
    flex-direction: row;
    margin-left: 100px;
  }

  .radioContainer fieldset {
    width: 250px;
  }

  .filterInputContainer {
    display: flex;
    flex-direction: column;
  }

  #filter-toggle-button {
    margin-bottom: 75px;
    padding: 10px 15px;
    font-size: 1rem;
    background-color: #444;
    border: none;
    border-radius: 5px;
  }

  #filter-form {
    height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      height 0.5s ease,
      opacity 0.5s ease;
  }

  .buttonSection {
    display: flex;
    flex-direction: column;
    width: 250px;
    margin: 0 auto;
  }

  .buttonSection button {
    padding: 0.5em 0;
  }

  @media (max-width: 900px) {
    select,
    #start-year-filter,
    #end-year-filter {
      width: 100vw;
      margin: 0 auto;
    }

    .radioContainer {
      flex-direction: column;
      width: 100%;
      margin: 0;
      justify-items: center;
    }

    .buttonSection {
      display: flex;
      flex-direction: column;
      width: 150px;
      margin: 0 auto;
    }

    .buttonSection button {
      padding: 0.5em 0;
    }

    .radioContainer fieldset {
      width: 150px;
      margin: 0 auto;
    }

    #genre-filter option {
      font-size: 0.8rem;
    }
  }
</style>
