---
import BaseLayout from "../layouts/BaseLayout.astro";
import WelcomeTop from "../components/WelcomeTop.astro";
import CategoryScroll from "../components/CategoryScroll.jsx";
import "../styles/front.css";

// Import categories and movies
import categoriesData from "../content/categories.json";
import moviesData from "../content/movies.json";

const categories = categoriesData.genres.slice(0, 5);
const movies = moviesData.results;
---

<BaseLayout title="MovieStore-lab">
  <main class="container-fluid">
    <WelcomeTop />

    {categories.map((cat) => (
      <CategoryScroll category={cat} movies={movies} client:load />
    ))}
  </main>
</BaseLayout>
